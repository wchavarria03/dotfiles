{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "includeGitInstructions": true,
  "permissions": {
    "allow": ["mcp__github__list_pull_requests"],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "lua-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/juliusbrussee/caveman.git"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "plansDirectory": "./.claude/plans",
  "tui": "default",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(podman rm:*)",
      "Bash(podman system prune:*)",
      "Bash(kubectl delete:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3api delete-bucket:*)"
    ]
  },
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/Users/wchavarria/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
