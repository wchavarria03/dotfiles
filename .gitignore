.DS_Store
scripts
.asdf
.config/op/
.config/cache
.config/local
.config/nvim/backupdir
.config/nvim/undodir
.config/nvim/swap
.config/asdf/installs
.config/asdf/shims
.config/asdf/plugins
.config/asdf/downloads
.config/zsh/.zsh_history
.config/zsh/.zsh_sessions
.config/zsh/.zcompdump
.config/zsh/.zcompcache
.config/configstore/
.config/lazysql/history/
.config/ltv-agent

# Swift Package Manager (machine-specific symlinks and cache)
.config/swiftpm/
.config/zsh/.zhistory
.config/containers/
.config/uv/

.cargo/registry/
.cargo/git/
.cargo/bin/
.cargo/*-cache
.cargo/*-cache-*

## Ignore nvim nightly build packages
nvim-macos-arm64
.config/carapace/bridge/zsh/.zcompdump_capture*
.config/github-copilot/

# 1Password app state (telemetry flag etc.) is per machine; only the SSH agent
# config is worth porting.
.config/1Password/*
!.config/1Password/ssh/

# cargo install metadata (regenerated per machine)
.cargo/.crates.toml
.cargo/.crates2.json

# colima VM runtime state (per machine)
.config/colima/

# herdr TUI is removed; ignore any leftover runtime dir so it never shows as untracked
.config/herdr/

# herdr-app: track only user-authored config; Herdr rewrites/owns the rest
.config/herdr-app/*
!.config/herdr-app/settings.json
!.config/herdr-app/keys.json
!.config/herdr-app/programs.json
.config/.android

