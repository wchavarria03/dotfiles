#!/bin/sh
# Git credential helper: serves a GitHub PAT, fetched from 1Password only when git asks.
# A $GITHUB_PAT already in the environment wins (e.g. a prompt-free token for agents).
# Otherwise the nearest .envrc (loaded by direnv) supplies GITHUB_PAT_ACCOUNT and
# GITHUB_PAT_REF, so opening a terminal never calls `op`.
[ "$1" = get ] || exit 0
pat="$GITHUB_PAT"
if [ -z "$pat" ] && [ -n "$GITHUB_PAT_ACCOUNT" ] && [ -n "$GITHUB_PAT_REF" ]; then
    pat=$(op read --account "$GITHUB_PAT_ACCOUNT" "$GITHUB_PAT_REF") || exit 1
fi
[ -n "$pat" ] || exit 1
echo "username=x-oauth-basic"
echo "password=$pat"
